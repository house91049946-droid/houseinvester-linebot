# LINE Bot 設定（必填）
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# 要監控的 LINE 群組 ID (逗號分隔，空白表示監控所有群組)
MONITORED_GROUP_IDS=

# 要忽略的使用者 ID (自己的 Bot)
IGNORED_USER_IDS=Udeadbeefdeadbeefdeadbeefdeadbeef

# ─── 報表回報設定 ───
NOTIFY_TARGET_USER_IDS=U00000000000000000000000000000000
ENABLE_REALTIME_NOTIFY=true
DAILY_SUMMARY_TIME=21:00
WEEKLY_SUMMARY_DAY=6
WEEKLY_SUMMARY_TIME=21:00

# 資料庫
DATABASE_URL=sqlite:///data/housing.db

# 日誌等級
LOG_LEVEL=INFO

# OpenAI API (GPT Vision 圖片辨識)
OPENAI_API_KEY=sk-your-openai-api-key

# 對外公開 URL（用於圖片轉發，ngrok URL 或正式 domain）
PUBLIC_BASE_URL=https://your-app.zeabur.app
